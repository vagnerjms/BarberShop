        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.body.contactPhone.startsWith('55') ? $json.body.contactPhone : '55' + $json.body.contactPhone }}\",\n  \"text\": \"Olá, *{{ $json.body.clientName }}*! \\n\\nSeu agendamento na *BarberStudio* foi confirmado com sucesso!\\n\\n✂️ *Serviço:* {{ $json.body.serviceName }}\\n💈 *Barbeiro:* {{ $json.body.barberName }}\\n📅 *Data/Hora:* {{ $json.body.dateTime }}\\n\\nTe esperamos lá! 💈\",\n  \"delay\": 1200\n}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        260,
        -100
      ],
      "id": "evolution-send-text",
      "name": "Evolution API - Enviar WhatsApp (Confirmacao)"
